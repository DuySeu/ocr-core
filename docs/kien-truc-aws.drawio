khong can model registry rieng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#0f1620);strokeColor=#999999;fontColor=#1A1A1A;fontSize=11;fontStyle=0;verticalAlign=middle;" vertex="1" parent="band_note"><mxGeometry x="996" y="60" width="320" height="96" as="geometry"/></mxCell><mxCell id="__title" value="Kien truc trien khai OCR tren AWS - 1 OCR / 2 Trich xuat thong tin / 3 Fine-tune" style="text;html=1;align=center;fontStyle=1;fontSize=14;fontColor=light-dark(#232F3E,#E8E8E8);" vertex="1" parent="1"><mxGeometry x="0" y="24" width="2278" height="30" as="geometry"/></mxCell><mxCell id="ed1" value="PDF can OCR" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;labelBackgroundColor=light-dark(#FFFFFF,#0B0F14);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3333333333333333;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecm" target="cgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="177" y="827"/><mxPoint x="146" y="827"/><mxPoint x="146" y="941"/><mxPoint x="169" y="941"/></Array></mxGeometry></mxCell><mxCell id="ed2" value="review UI" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;labelBackgroundColor=light-dark(#FFFFFF,#0B0F14);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6666666666666666;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reviewers" target="cgw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="177" y="928"/><mxPoint x="185" y="928"/></Array></mxGeometry></mxCell><mxCell id="ed3" value="private VIF" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jettySize=auto;orthogonalLoop=1;fontSize=10;fontColor=light-dark(#1B2733,#CFE0F0);strokeColor=light-dark(#1A1A1A,#E0E0E0);strokeWidth=1;labe